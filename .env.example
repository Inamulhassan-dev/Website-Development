# ---------------------------------------------------------------------------
# Umar Baig Platform - environment configuration
# Copy this file to `.env` (never commit real secrets).
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local embedded Postgres (npm run dev:db):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
# Production (Neon / Render / Railway) example:
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Public base URL, used for referral links and password-reset links.
# Local: http://localhost:3000   Production: https://your-app.onrender.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign short-lived CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET="replace-with-a-long-random-string"

# How long a login session lasts (days).
SESSION_TTL_DAYS="14"

# Password-reset links are written to the server log in this demo build.
# No email provider is connected, and none is claimed to be.
AUTH_DEBUG_LOG_RESET_LINKS="true"

# Media storage. `local` writes to ./storage/uploads (not persistent on
# ephemeral hosts). Use `s3` with an S3-compatible bucket in production.
MEDIA_STORAGE="local"
MEDIA_DIR="./storage/uploads"
# S3-compatible settings (Cloudflare R2, AWS S3, Backblaze B2 ...)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
